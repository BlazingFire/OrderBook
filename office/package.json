{
  "name": "@orderbook/office",
  "version": "1.4.8",
  "homepage": "https://github.com/blazingfire/orderbook",
  "private": true,
  "type": "module",
  "main": "electron/dist/office.main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build --workspace @orderbook/office-web",
    "build:server": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@orderbook/shared": "*",
    "express": "^4.21.1",
    "multer": "^2.0.0",
    "socket.io-client": "^4.8.1",
    "undici": "5.29.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "tsx": "^4.19.2"
  }
}
