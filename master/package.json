{
  "name": "@orderbook/master",
  "version": "1.4.8",
  "homepage": "https://github.com/blazingfire/orderbook",
  "private": true,
  "type": "module",
  "main": "electron/dist/master.main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build --workspace @orderbook/master-web",
    "build:server": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "reload:catalog": "tsx src/services/catalog-reload-cli.ts --catalogue",
    "wipe:business": "tsx src/services/catalog-reload-cli.ts",
    "seed:parties": "tsx src/services/catalog-reload-cli.ts --with-parties",
    "seed:demo-parties": "tsx src/services/catalog-reload-cli.ts --demo-parties",
    "seed:dummy": "tsx src/db/seed-dummy-users-cli.ts",
    "seed:sample": "tsx src/db/seed-sample-data-cli.ts",
    "seed:catalogue": "tsx src/db/seed-catalogue-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@orderbook/shared": "*",
    "archiver": "^5.3.2",
    "bcryptjs": "^2.4.3",
    "blurhash": "^2.0.5",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "knex": "^3.1.0",
    "multer": "^2.0.0",
    "pdfkit": "^0.20.1",
    "pg": "^8.13.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@types/archiver": "^5.3.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/fontkit": "^2.0.9",
    "@types/multer": "^1.4.12",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/yauzl": "^2.10.3",
    "fontkit": "^2.0.4",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "^17.10.0-beta.17",
    "@embedded-postgres/darwin-x64": "^17.10.0-beta.17",
    "@embedded-postgres/linux-arm64": "^17.10.0-beta.17",
    "@embedded-postgres/linux-x64": "^17.10.0-beta.17",
    "@embedded-postgres/windows-x64": "^17.10.0-beta.17"
  }
}
