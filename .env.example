# Copy this file to `.env` and edit it. `.env` is gitignored, so anything you
# put there — including database passwords — stays off the repository.
#
# Everything here is optional. With no .env at all, the Master Panel starts and
# manages its own bundled PostgreSQL and needs no configuration.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Use an existing PostgreSQL server instead of the bundled one. When this is
# set, the app does not create or manage a database cluster at all — it just
# connects, and expects the database named at the end of the URL to exist.
#
#   postgres://USER:PASSWORD@HOST:PORT/DATABASE
#
# A password containing @ : / or ? must be percent-encoded.
# DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/order_book

# Keep the app's self-managed cluster, but use PostgreSQL binaries installed
# elsewhere. Point at the directory containing initdb and pg_ctl.
# ORDERBOOK_PG_BIN=C:\Program Files\PostgreSQL\17\bin

# Port for the bundled cluster. Only change this if 55432 is already taken.
# ORDERBOOK_PG_PORT=55432

# ---------------------------------------------------------------------------
# Master Panel
# ---------------------------------------------------------------------------

# Port the Master Panel serves on. Office Panels reach it here, so changing it
# means re-pairing any panel that used the old address.
# PORT=4100

# Where the database, uploads and generated secrets are stored.
# ORDERBOOK_DATA_DIR=C:\OrderBookData

# ---------------------------------------------------------------------------
# Updates
# ---------------------------------------------------------------------------

# Where builds are kept. The Master installs its own from here and serves the
# office build to every panel over the LAN.
# ORDERBOOK_RELEASES_DIR=C:\OrderBook-Releases

# A GitHub repository to fetch published builds from, as owner/repo. Leave it
# unset and the folder above is the only source, which is the air-gapped case.
# Point it at a PUBLIC repository holding nothing but release assets: assets on
# a private repository need a token, and that token would have to ship to every
# shop PC. Only the Master ever talks to GitHub.
# ORDERBOOK_RELEASES_GITHUB_REPO=you/orderbook-releases

# Only if the releases repository really must be private. Read the sentence
# above first.
# ORDERBOOK_RELEASES_GITHUB_TOKEN=

# How often the Master asks GitHub, in minutes. 0 switches polling off and
# leaves the Updates screen as the only trigger.
# ORDERBOOK_RELEASES_POLL_MINUTES=180

# Accept releases that carry no signature. Per-machine and opt-in, for a site
# that copies builds in by hand from a USB stick. Never set this on a machine
# that fetches updates over a network.
# ORDERBOOK_ALLOW_UNSIGNED_RELEASES=1

# ---------------------------------------------------------------------------
# Office Panel
# ---------------------------------------------------------------------------

# OFFICE_PORT=4200
# OFFICE_PANEL_NAME=Front Desk PC

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# debug | info | warn | error
# LOG_LEVEL=info
