node_modules/
dist/
build/
*.tsbuildinfo

# Packaging output. `staging/` is the folder the setup file lays down,
# `vendor/` is the 100 MB of PostgreSQL copied into it, and the setup files
# themselves go to the releases folder outside this repo entirely.
*/staging/
master/vendor/

# Runtime data — Postgres cluster, uploaded images, local panel credentials.
# Never committed: this is per-installation state, not source.
data/
*/data/

# Local environment overrides
.env
.env.local
*.local

# Logs
*.log
npm-debug.log*
logs/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Per-tool local state for the AI agents that work on this repo (see
# docs/AI_COLLABORATION.md) — learned preferences and session scratch, not
# project source. Each agent's own state stays local; coordination happens
# through files already tracked in the repo (HANDOFF.md, docs/ai-handoffs/).
# The skills/ subdirectory is the exception: Command Code project skills are
# shared with the team and tracked like any other convention (see AGENTS.md).
.commandcode/*
!.commandcode/skills/
!.commandcode/skills/**
.claude/launch.json

# Operator-supplied catalogue source and working fixtures — untracked by
# design. Nothing reads them: the catalogue was transcribed from them into
# `master/src/domain/swisware-catalogue.ts`, which the reload script loads as
# pure data.
CATA.pdf
dummy-data/

# The product backup zip `npm run release -- --catalogue <zip>` copies in, so a
# build ships the company's current catalogue (docs/UPDATES.md). Generated from
# a live Master, so never committed by accident; committing one is the owner's
# call (`git add -f`).
master/assets/catalogue/products.zip

# Stray local test-run logs, not source.
vitest-out.txt
.tmp/

# The report `npm run test:coverage` writes.
coverage/

# Written when an installer is compiled by tools/bake-script-hashes.cjs (the SHA-256 of the scripts it runs elevated).
master/installer/script-hashes.nsh
office/installer/script-hashes.nsh
